# Required
DATABASE_URL=postgres://r4ck:r4ck@localhost:5442/r4ck
SITE_URL=http://localhost:3000

# Identity
SITE_NAME=r4ck
ADMIN_EMAILS=
SESSION_TTL_DAYS=90
ROLES=web,worker
PORT=3000

# Upstream: the NicheDB hosting collection this index mirrors
NICHEDB_URL=https://nichedb.dev
NICHEDB_KEY=
SYNC_MINUTES=30
SYNC_ON_BOOT=true

# Mail (magic links) via Resend. Point MAIL_FROM at a verified sender.
RESEND_API_KEY=
MAIL_FROM=r4ck <hello@profullstack.com>

# API allowances per hour
API_ANON_PER_HOUR=300
API_KEY_PER_HOUR=6000

# x402 crawl passes (CoinPay). Without these the gate still answers 402 but sells nothing.
COINPAY_X402_KEY=
CRAWL_PAY_TO=
CRAWL_PRICE_CENTS=100
CRAWL_PASS_MINUTES=1440
CRAWL_MAX_DAYS=30
CRAWL_CONTACT=mailto:hello@profullstack.com

# Foreign exchange (USD per unit), overrides the built-in table. JSON object.
FX_RATES_JSON=
